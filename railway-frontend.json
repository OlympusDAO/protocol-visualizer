{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile-frontend",
    "watchPatterns": [
      "apps/frontend/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "railway-frontend.json",
      "Dockerfile-frontend"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 10,
    "restartPolicyType": "ALWAYS"
  }
}
