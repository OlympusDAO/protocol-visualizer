{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "lint:check": {
      "dependsOn": ["^lint:check"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "indexer#build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "frontend#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "@protocol-visualizer/contract-abis#build": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
