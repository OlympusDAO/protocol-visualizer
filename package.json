{
  "name": "protocol-visualizer",
  "private": true,
  "packageManager": "pnpm@11.28.7",
  "scripts": {
    "build": "turbo run build && pnpm run railway:check && pnpm run test:config",
    "check:runtime-versions": "node scripts/verify-runtime-versions.mjs",
    "benchmark:indexer": "node -- scripts/benchmark-indexer.mjs",
    "benchmark:indexer:current": "node -- scripts/benchmark-indexer-current.mjs",
    "benchmark:indexer:compare": "node scripts/benchmark-indexer.mjs --compare-ref",
    "container:build": "pnpm run container:build:rpc-cache && pnpm run container:build:indexer && pnpm run container:build:frontend && pnpm run container:build:hasura && pnpm run container:build:snapshot-gateway && pnpm run container:build:snapshot-publisher && pnpm run container:build:snapshot-monitor",
    "container:build:frontend": "node scripts/container.mjs build -f Dockerfile-frontend --build-arg VITE_PROTOCOL_SNAPSHOT_BASE_URL=http://localhost:8082 -t protocol-visualizer/frontend:local .",
    "container:build:hasura": "node scripts/container.mjs build -f Dockerfile-hasura -t protocol-visualizer/hasura:local .",
    "container:scan": "node scripts/scan-container.mjs",
    "container:scan:hasura": "node scripts/scan-container.mjs hasura",
    "container:build:indexer": "node scripts/container.mjs build -f Dockerfile-indexer -t protocol-visualizer/indexer:local .",
    "container:build:snapshot-gateway": "node scripts/container.mjs build -f Dockerfile-snapshot-gateway -t protocol-visualizer/snapshot-gateway:local .",
    "container:build:snapshot-monitor": "node scripts/container.mjs build -f Dockerfile-snapshot-monitor -t protocol-visualizer/snapshot-monitor:local .",
    "container:build:snapshot-publisher": "node scripts/container.mjs build -f Dockerfile-snapshot-publisher -t protocol-visualizer/snapshot-publisher:local .",
    "container:tag:scan:frontend": "node scripts/container.mjs tag protocol-visualizer/frontend:local protocol-visualizer/frontend:scan",
    "container:tag:scan:hasura": "node scripts/container.mjs tag protocol-visualizer/hasura:local protocol-visualizer/hasura:scan",
    "container:tag:scan:indexer": "node scripts/container.mjs tag protocol-visualizer/indexer:local protocol-visualizer/indexer:scan",
    "container:tag:scan:snapshot-gateway": "node scripts/container.mjs tag protocol-visualizer/snapshot-gateway:local protocol-visualizer/snapshot-gateway:scan",
    "container:tag:scan:snapshot-monitor": "node scripts/container.mjs tag protocol-visualizer/snapshot-monitor:local protocol-visualizer/snapshot-monitor:scan",
    "container:tag:scan:snapshot-publisher": "node scripts/container.mjs tag protocol-visualizer/snapshot-publisher:local protocol-visualizer/snapshot-publisher:scan",
    "dev": "turbo run dev",
    "indexer:dev": "env ENVIO_TUI=false pnpm --dir apps/indexer exec node scripts/start-envio.mjs dev",
    "indexer:dev:reset": "env ENVIO_TUI=false pnpm --dir apps/indexer exec node scripts/start-envio.mjs dev -r",
    "indexer:metadata": "node scripts/generate-indexer-contract-metadata.mjs",
    "indexer:metrics": "sh -c 'curl -s \"http://localhost:${ENVIO_INDEXER_PORT:-9898}/metrics\" | rg \"envio_progress_|hyperindex_synced_to_head|envio_effect_\"'",
    "rpc-cache:metrics": "node scripts/railway-ops.mjs metrics",
    "lint:check": "turbo run lint:check && biome format .",
    "lint": "turbo run lint && biome format --write .",
    "openapi:check": "pnpm --filter snapshot-gateway run openapi:check",
    "snapshots:generate:local": "pnpm --filter snapshot-publisher run build && env SNAPSHOT_OUTPUT_DIR=/tmp/protocol-visualizer-snapshots SNAPSHOT_SOURCE=sample pnpm --filter snapshot-publisher start",
    "stack:config": "node scripts/container.mjs compose config",
    "stack:down": "node scripts/container.mjs compose down",
    "stack:logs": "node scripts/container.mjs compose logs -f",
    "stack:monitor": "node scripts/container.mjs compose --profile jobs run --rm snapshot-monitor",
    "stack:publish": "node scripts/container.mjs compose run --rm snapshot-publisher",
    "stack:publish:sample": "node scripts/container.mjs compose run --rm snapshot-publisher-sample",
    "stack:up": "node scripts/container.mjs compose up --build rpc-cache-postgres rpc-cache postgres hasura minio minio-create-bucket indexer snapshot-gateway frontend",
    "test:config": "pnpm --filter snapshot-publisher... run build && pnpm --filter snapshot-monitor run build && pnpm --filter snapshot-gateway exec tsc && node --test tests/*.test.mjs",
    "validate": "./scripts/validate.sh",
    "validate:local": "pnpm run check:runtime-versions && pnpm install --frozen-lockfile && pnpm run lint:check && pnpm --filter @protocol-visualizer/snapshot-artifacts run build && pnpm run openapi:check && pnpm run build && pnpm run snapshots:generate:local && pnpm run container:build:indexer && pnpm run container:build:frontend && pnpm run container:build:hasura && pnpm run container:build:snapshot-gateway && pnpm run container:build:snapshot-publisher && pnpm run container:build:snapshot-monitor",
    "format": "biome format --write .",
    "container:build:rpc-cache": "node scripts/container.mjs build -f Dockerfile-rpc-cache -t protocol-visualizer/rpc-cache:local .",
    "container:tag:scan:rpc-cache": "node scripts/container.mjs tag protocol-visualizer/rpc-cache:local protocol-visualizer/rpc-cache:scan",
    "test:rpc-cache": "node --test services/rpc-cache/integration.test.mjs",
    "indexer:reset:railway": "node scripts/railway-ops.mjs reset",
    "railway:check": "tsc -p .railway/tsconfig.json",
    "railway:plan": "node scripts/railway-ops.mjs plan",
    "railway:apply": "node scripts/railway-ops.mjs apply"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24.19.2",
    "@typescript/typescript6": "^6.0.2",
    "semver": "^7.8.5",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2",
    "railway": "3.16.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=11.28.7",
    "bun": "use-pnpm",
    "npm": "use-pnpm",
    "yarn": "use-pnpm"
  }
}
