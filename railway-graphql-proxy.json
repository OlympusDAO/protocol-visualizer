{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile-graphql-proxy",
    "watchPatterns": [
      "apps/graphql-proxy/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "Dockerfile-graphql-proxy",
      "railway-graphql-proxy.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ALWAYS"
  }
}
