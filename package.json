{
  "name": "protocol-visualizer",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check:runtime-versions": "node scripts/verify-runtime-versions.mjs",
    "dev": "turbo run dev",
    "lint:check": "turbo run lint:check",
    "lint": "turbo run lint && prettier --write \"**/*.{js,mjs,ts,tsx,md,json}\"",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,md,json}\"",
    "preinstall": "npx only-allow@1.2.2 pnpm"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.11.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.7.4",
    "turbo": "^2.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  },
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "@hono/node-server": ">=1.19.10",
      "@hono/node-server@<1.19.10": ">=1.19.10",
      "ajv": "6.14.0",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "brace-expansion": ">=2.0.3",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "esbuild@<=0.24.2": ">=0.25.0",
      "flatted": ">=3.4.2",
      "flatted@<3.4.0": ">=3.4.0",
      "flatted@<=3.4.1": ">=3.4.2",
      "hono": ">=4.12.7",
      "hono@<4.11.10": ">=4.11.10",
      "hono@<4.11.7": ">=4.11.7",
      "hono@<4.12.4": ">=4.12.4",
      "hono@<4.12.7": ">=4.12.7",
      "kysely": ">=0.28.14",
      "kysely@<=0.28.13": ">=0.28.14",
      "kysely@>=0.26.0 <=0.28.11": ">=0.28.12",
      "lodash": ">=4.18.0",
      "lodash@<=4.17.23": ">=4.18.0",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "lodash@>=4.0.0 <=4.17.23": ">=4.18.0",
      "minimatch": "9.0.7",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@<3.1.4": ">=3.1.4",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "picomatch": "4.0.4",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "rollup": ">=4.59.0",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "vite@>=5.0.0 <5.4.21": ">=5.4.21",
      "yaml": ">=2.8.3",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "eslint-plugin-import>minimatch": "9.0.7",
      "@eslint/eslintrc>minimatch": "5.1.8",
      "micromatch>picomatch": "4.0.4"
    }
  },
  "engines": {
    "node": "22.x",
    "pnpm": "10.33.0",
    "npm": "use-pnpm",
    "yarn": "use-pnpm"
  }
}
