# Indexer env sample.
# Required values are uncommented. Optional overrides are commented.

# Required RPC URLs for the chains enabled in config.yaml.
ENVIO_RPC_URL_1=
ENVIO_RPC_URL_10=
ENVIO_RPC_URL_8453=
ENVIO_RPC_URL_80094=
ENVIO_RPC_URL_11155111=

# Required for production wrapper runs.
DATABASE_URL=
HASURA_GRAPHQL_ENDPOINT=
HASURA_GRAPHQL_ADMIN_SECRET=

# Optional but strongly recommended. Local Docker Compose requires this token so
# ingestion uses HyperSync with RPC fallback instead of slow RPC-only indexing.
# ENVIO_API_TOKEN=

# Optional. Defaults to "fallback" when ENVIO_API_TOKEN is set, otherwise
# "sync". Must be "sync" for RPC-only indexing, or "fallback" for HyperSync
# with RPC fallback.
# ENVIO_RPC_MODE=

# Optional. Arbitrum remains supported by the snapshot contract, but it is not
# currently enabled in indexer config.yaml.
# ENVIO_RPC_URL_42161=

# Optional fallback RPC URLs for effect-handler reads.
# ENVIO_RPC_URL_FALLBACK_1=
# ENVIO_RPC_URL_FALLBACK_10=
# ENVIO_RPC_URL_FALLBACK_8453=
# ENVIO_RPC_URL_FALLBACK_80094=
# ENVIO_RPC_URL_FALLBACK_11155111=

# Optional explicit Envio Postgres settings. These override DATABASE_URL parsing
# when set.
# ENVIO_PG_HOST=
# ENVIO_PG_PORT=
# ENVIO_PG_USER=
# ENVIO_PG_PASSWORD=
# ENVIO_PG_DATABASE=
# ENVIO_PG_SCHEMA=
# ENVIO_PG_SSL_MODE=

# Optional local and self-hosted runtime settings.
# ENVIO_PG_EXTERNAL_PORT=5433
# ENVIO_INDEXER_PORT=9898
# ENVIO_HEALTHCHECK_WRAPPER_ENABLED=
# ENVIO_INDEXER_INTERNAL_PORT=
# HASURA_EXTERNAL_PORT=8080

# Optional explorer API key for Envio contract metadata workflows.
# ETHERSCAN_API_KEY=
