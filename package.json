{
  "name": "protocol-visualizer",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build && pnpm run test:config",
    "check:runtime-versions": "node scripts/verify-runtime-versions.mjs",
    "docker:build:frontend": "docker build -f Dockerfile-frontend --build-arg VITE_PROTOCOL_SNAPSHOT_BASE_URL=http://localhost:8082 -t protocol-visualizer/frontend:local .",
    "docker:build:hasura": "docker build -f Dockerfile-hasura -t protocol-visualizer/hasura:local .",
    "docker:build:indexer": "docker build -f Dockerfile-indexer -t protocol-visualizer/indexer:local .",
    "docker:build:snapshot-gateway": "docker build -f Dockerfile-snapshot-gateway -t protocol-visualizer/snapshot-gateway:local .",
    "docker:build:snapshot-monitor": "docker build -f Dockerfile-snapshot-monitor -t protocol-visualizer/snapshot-monitor:local .",
    "docker:build:snapshot-publisher": "docker build -f Dockerfile-snapshot-publisher -t protocol-visualizer/snapshot-publisher:local .",
    "docker:tag:scan:frontend": "docker tag protocol-visualizer/frontend:local protocol-visualizer/frontend:scan",
    "docker:tag:scan:hasura": "docker tag protocol-visualizer/hasura:local protocol-visualizer/hasura:scan",
    "docker:tag:scan:indexer": "docker tag protocol-visualizer/indexer:local protocol-visualizer/indexer:scan",
    "docker:tag:scan:snapshot-gateway": "docker tag protocol-visualizer/snapshot-gateway:local protocol-visualizer/snapshot-gateway:scan",
    "docker:tag:scan:snapshot-monitor": "docker tag protocol-visualizer/snapshot-monitor:local protocol-visualizer/snapshot-monitor:scan",
    "docker:tag:scan:snapshot-publisher": "docker tag protocol-visualizer/snapshot-publisher:local protocol-visualizer/snapshot-publisher:scan",
    "dev": "turbo run dev",
    "indexer:dev": "env ENVIO_TUI=false pnpm --dir apps/indexer exec node scripts/start-envio.mjs dev",
    "indexer:dev:reset": "env ENVIO_TUI=false pnpm --dir apps/indexer exec node scripts/start-envio.mjs dev -r",
    "indexer:metadata": "node scripts/generate-indexer-contract-metadata.mjs",
    "indexer:metrics": "sh -c 'curl -s \"http://localhost:${ENVIO_INDEXER_PORT:-9898}/metrics\" | rg \"envio_progress_|hyperindex_synced_to_head|envio_effect_\"'",
    "lint:check": "turbo run lint:check",
    "lint": "turbo run lint && biome format --write .",
    "openapi:check": "pnpm --filter snapshot-gateway run openapi:check",
    "snapshots:generate:local": "pnpm --filter snapshot-publisher run build && env SNAPSHOT_OUTPUT_DIR=/tmp/protocol-visualizer-snapshots SNAPSHOT_SOURCE=sample pnpm --filter snapshot-publisher start",
    "stack:config": "docker compose config",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "stack:monitor": "docker compose --profile jobs run --rm snapshot-monitor",
    "stack:publish": "docker compose run --rm snapshot-publisher",
    "stack:publish:sample": "docker compose run --rm snapshot-publisher-sample",
    "stack:up": "docker compose up --build postgres hasura minio minio-create-bucket indexer snapshot-gateway frontend",
    "test:config": "node --test tests/*.test.mjs",
    "validate:local": "pnpm run check:runtime-versions && pnpm install --frozen-lockfile && pnpm run lint:check && pnpm run build && pnpm run openapi:check && pnpm run snapshots:generate:local && pnpm run docker:build:indexer && pnpm run docker:build:frontend && pnpm run docker:build:hasura && pnpm run docker:build:snapshot-gateway && pnpm run docker:build:snapshot-publisher && pnpm run docker:build:snapshot-monitor",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^24.0.0",
    "semver": "^7.7.4",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.33.0",
    "bun": "use-pnpm",
    "npm": "use-pnpm",
    "yarn": "use-pnpm"
  }
}
