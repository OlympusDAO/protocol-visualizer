ENVIO_RPC_URL_1=
ENVIO_RPC_URL_42161=
ENVIO_RPC_URL_8453=
ENVIO_RPC_URL_80094=
ENVIO_RPC_URL_10=
ENVIO_RPC_URL_11155111=

# Optional. Only needed if config.yaml is changed back to HyperSync-backed
# indexing. The default self-hosted config sources historical sync from RPC.
ENVIO_API_TOKEN=

# Optional. Defaults to "fallback" when ENVIO_API_TOKEN is set, otherwise
# "sync". Must be "sync" for RPC-only indexing, or "fallback" for HyperSync
# with RPC fallback.
ENVIO_RPC_MODE=

# Postgres database URL. The Envio Docker entrypoint maps this to ENVIO_PG_*.
DATABASE_URL=

# Optional explicit Envio Postgres settings. These override DATABASE_URL parsing
# when set.
ENVIO_PG_HOST=
ENVIO_PG_PORT=
ENVIO_PG_USER=
ENVIO_PG_PASSWORD=
ENVIO_PG_DATABASE=
ENVIO_PG_SCHEMA=
ENVIO_PG_SSL_MODE=

# Self-hosted Docker Compose settings.
ENVIO_PG_EXTERNAL_PORT=5433
ENVIO_INDEXER_PORT=9898
HASURA_EXTERNAL_PORT=8080
HASURA_GRAPHQL_ADMIN_SECRET=testing

ETHERSCAN_API_KEY=
