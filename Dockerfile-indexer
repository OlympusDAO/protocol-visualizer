# Build stage
# Pinned image: node:24-alpine (Node v24.14.1)
FROM node:24-alpine@sha256:01743339035a5c3c11a373cd7c83aeab6ed1457b55da6a69e014a95ac4e4700b AS builder

# Apply Alpine security updates
RUN apk upgrade --no-cache zlib libssl3 libcrypto3

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# Set working directory
WORKDIR /app

# Copy pnpm files and root package.json (for overrides)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/indexer/package.json ./apps/indexer/

# Install production dependencies
RUN pnpm install --frozen-lockfile --prod

# npm is not needed at runtime. Keep corepack/pnpm for `pnpm exec` and
# remove npm to reduce toolchain-only CVE surface in production images.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

# Copy source code
COPY apps/indexer/ ./apps/indexer/

# Nothing to build

# Set environment variables
ENV NODE_ENV=production

# Use non-root user
RUN addgroup -S app && adduser -S app -G app && chown -R app:app /app

# Expose the port the app runs on
EXPOSE 3000

# Start the application
WORKDIR /app/apps/indexer
USER app
CMD ["sh", "-c", "pnpm exec ponder start --schema ${RAILWAY_DEPLOYMENT_ID}"]
