# Dependency stage
# Pinned image: node:24.22.1-alpine (Node v24.22.1)
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS deps

RUN apk upgrade --no-cache musl musl-utils zlib libssl3 libcrypto3 nghttp2-libs xz-libs

RUN corepack enable && corepack prepare pnpm@11.28.7 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/snapshot-publisher/package.json ./apps/snapshot-publisher/
COPY packages/snapshot-artifacts/package.json ./packages/snapshot-artifacts/
COPY packages/protocol-config/protocol-chains.json ./config/protocol-chains.json
COPY packages/protocol-config/other-contracts.json ./config/other-contracts.json

RUN pnpm install --frozen-lockfile --filter snapshot-publisher...

COPY apps/snapshot-publisher/ ./apps/snapshot-publisher/
COPY packages/snapshot-artifacts/ ./packages/snapshot-artifacts/

RUN pnpm --filter @protocol-visualizer/snapshot-artifacts run build \
    && pnpm --filter snapshot-publisher run build \
    && pnpm deploy --legacy --filter snapshot-publisher --prod /deploy/snapshot-publisher \
    && rm -rf \
        /deploy/snapshot-publisher/node_modules/.modules.yaml \
        /deploy/snapshot-publisher/node_modules/.pnpm/lock.yaml \
    && find /deploy/snapshot-publisher -type f -name "*.d.ts" -delete

# Runtime stage
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS runtime

RUN apk upgrade --no-cache musl musl-utils zlib libssl3 libcrypto3 nghttp2-libs xz-libs

WORKDIR /app

COPY --from=deps /deploy/snapshot-publisher ./apps/snapshot-publisher
COPY --from=deps /app/config/protocol-chains.json ./config/protocol-chains.json
COPY --from=deps /app/config/other-contracts.json ./config/other-contracts.json

RUN rm -rf \
    /root/.cache/node/corepack \
    /usr/local/lib/node_modules/corepack \
    /usr/local/lib/node_modules/npm \
    /usr/local/bin/corepack \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/pnpm \
    /usr/local/bin/pnpx

ENV NODE_ENV=production
ENV PROTOCOL_CHAINS_CONFIG_PATH=/app/config/protocol-chains.json
ENV OTHER_CONTRACTS_CONFIG_PATH=/app/config/other-contracts.json

RUN addgroup -S app && adduser -S app -G app && chown -R app:app /app

WORKDIR /app/apps/snapshot-publisher
USER app
CMD ["node", "dist/src/publish.js"]
