{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile-snapshot-publisher",
    "watchPatterns": [
      "apps/snapshot-publisher/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "Dockerfile-snapshot-publisher",
      "railway-snapshot-publisher.json"
    ]
  },
  "deploy": {
    "cronSchedule": "0 * * * *",
    "restartPolicyType": "NEVER"
  }
}
