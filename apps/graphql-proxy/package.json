{
  "name": "graphql-proxy",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --check src/server.mjs",
    "dev": "env PORT=8081 HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql node src/server.mjs",
    "lint": "biome lint --write . --error-on-warnings",
    "lint:check": "biome lint . --error-on-warnings",
    "start": "node src/server.mjs"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.33.0",
    "bun": "use-pnpm",
    "npm": "use-pnpm",
    "yarn": "use-pnpm"
  }
}
