# Local Docker Compose env sample.
# Copy to .env before running the compose stack.
# Required values are uncommented. Optional overrides are commented.

# Required. Compose requires this token so local event ingestion uses HyperSync
# with RPC fallback by default instead of slow RPC-only indexing.
ENVIO_API_TOKEN=CHANGEME

# Required RPC URLs for the chains enabled in apps/indexer/config.yaml.
ENVIO_RPC_URL_1=
ENVIO_RPC_URL_10=
ENVIO_RPC_URL_42161=
ENVIO_RPC_URL_8453=
ENVIO_RPC_URL_80094=
ENVIO_RPC_URL_11155111=

# Required for fetching contract metadata that is not already precomputed or
# present in local ABI/source-code files.
ETHERSCAN_API_KEY=

# Optional host port overrides.
# POSTGRES_HOST_PORT=5432
# HASURA_HOST_PORT=8080
# INDEXER_HOST_PORT=9898
# SNAPSHOT_GATEWAY_HOST_PORT=8082
# FRONTEND_HOST_PORT=3000
# MINIO_API_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001

# Optional local database overrides.
# POSTGRES_DB=protocol_visualizer
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# Optional local Hasura admin secret override.
# HASURA_GRAPHQL_ADMIN_SECRET=local-hasura-admin-secret

# Optional local S3-compatible bucket overrides for MinIO.
# BUCKET=protocol-visualizer-snapshots
# ACCESS_KEY_ID=minioadmin
# SECRET_ACCESS_KEY=minioadmin
# REGION=us-east-1

# Optional frontend and publisher public URL overrides.
# VITE_PROTOCOL_SNAPSHOT_BASE_URL=http://localhost:8082
# SNAPSHOT_PUBLIC_ORIGIN=http://localhost:8082

# Optional local snapshot deployment identity and monitor settings.
# INDEXER_DEPLOYMENT_ID=local-compose
# INDEXER_METRICS_URL=http://indexer:9898/metrics
# DISCORD_WEBHOOK_URL=
# MONITOR_STATE_KEY=v1/monitor-state.json
# MONITOR_STALE_CHAIN_HOURS=24

# Optional indexer mode and publisher chain subset.
# Set ENVIO_RPC_MODE=sync only when deliberately testing RPC-only ingestion.
# ENVIO_RPC_MODE=
# SNAPSHOT_CHAIN_IDS=
