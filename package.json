{
  "name": "protocol-visualizer",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "check:runtime-versions": "node scripts/verify-runtime-versions.mjs",
    "docker:build:frontend": "docker build -f Dockerfile-frontend --build-arg VITE_PONDER_URL=https://example.com -t protocol-visualizer/frontend:local .",
    "docker:build:indexer": "docker build -f Dockerfile-indexer -t protocol-visualizer/indexer:local .",
    "docker:tag:scan:frontend": "docker tag protocol-visualizer/frontend:local protocol-visualizer/frontend:scan",
    "docker:tag:scan:indexer": "docker tag protocol-visualizer/indexer:local protocol-visualizer/indexer:scan",
    "dev": "turbo run dev",
    "lint:check": "biome check .",
    "lint": "biome check --write .",
    "validate:local": "pnpm run check:runtime-versions && pnpm install --frozen-lockfile && pnpm run lint:check && pnpm run build && pnpm run docker:build:indexer && pnpm run docker:build:frontend",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^24.0.0",
    "semver": "^7.7.4",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.33.0",
    "bun": "use-pnpm",
    "npm": "use-pnpm",
    "yarn": "use-pnpm"
  }
}
