{
  "name": "snapshot-gateway",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "files": [
    "dist/src",
    "openapi.json"
  ],
  "scripts": {
    "start": "node dist/src/index.js",
    "build": "tsc && node dist/scripts/generate-openapi.js --check",
    "openapi:check": "tsc && node dist/scripts/generate-openapi.js --check",
    "lint": "biome lint --write . --error-on-warnings",
    "lint:check": "biome lint . --error-on-warnings",
    "test": "node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "openapi:generate": "pnpm --filter @protocol-visualizer/snapshot-artifacts build && tsc && node dist/scripts/generate-openapi.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@protocol-visualizer/snapshot-artifacts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.22.3"
  }
}
