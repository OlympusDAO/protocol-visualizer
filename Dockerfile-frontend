# Build stage
FROM node:24-alpine@sha256:01743339035a5c3c11a373cd7c83aeab6ed1457b55da6a69e014a95ac4e4700b AS builder

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# Set working directory
WORKDIR /app

# Copy pnpm files and root package.json (for overrides)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/frontend/package.json ./apps/frontend/
COPY apps/indexer/package.json ./apps/indexer/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
# Indexer needed due to the ponder schema
COPY apps/indexer/ ./apps/indexer/
COPY apps/frontend/ ./apps/frontend/

WORKDIR /app/apps/frontend

# Environment variables
ARG VITE_PONDER_URL
ENV VITE_PONDER_URL=$VITE_PONDER_URL

# Build the application
RUN pnpm run build

# Production stage
FROM nginxinc/nginx-unprivileged:alpine@sha256:601c823234c474696ded03d619e67f1e59538802731543099c691aea67e4a553

# Apply Alpine security updates
USER root
RUN apk upgrade --no-cache zlib libssl3 libcrypto3 libuuid libpng

# Copy the built static files to Nginx's serve directory
COPY --from=builder /app/apps/frontend/dist /usr/share/nginx/html

# Copy Nginx config
COPY --from=builder /app/apps/frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

USER 101
