# Dependency stage
# Pinned image: node:24.22.1-slim (Node v24.22.1, Debian/glibc)
FROM node:24.22.1-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS deps

# Install pnpm
RUN corepack enable && corepack prepare pnpm@11.28.7 --activate

# Set working directory
WORKDIR /app

# Copy pnpm files and root package.json (for overrides)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/indexer/package.json ./apps/indexer/

# Install production dependencies
RUN pnpm install --frozen-lockfile --prod

# Copy source code
COPY apps/indexer/ ./apps/indexer/
COPY packages/protocol-config/ ./packages/protocol-config/
COPY packages/snapshot-artifacts/src/observation-constants.ts ./packages/snapshot-artifacts/src/observation-constants.ts

# Railway SSH requires sh even when the requested command is Node.
FROM gcr.io/distroless/static-debian13:debug-nonroot@sha256:12c2026b21e05857a4c730b4dbf812becf02b396cb7916166c8305f45f140ab0 AS shell

# Runtime stage
# Pinned image index: gcr.io/distroless/nodejs24-debian13 (Node 24.22.3; patched zlib1g)
FROM gcr.io/distroless/nodejs24-debian13@sha256:d1c8c1be703f1dca243457ac656e7eee7c571a7136a6e681d17c4294e6fe7a6d AS runtime

COPY --from=shell --chmod=0755 /busybox/busybox /usr/bin/sh

# Set working directory
WORKDIR /app

# Copy runtime dependencies and source from dependency stage
COPY --from=deps --chown=nonroot:nonroot /app/node_modules ./node_modules
COPY --from=deps --chown=nonroot:nonroot /app/apps/indexer ./apps/indexer
COPY --from=deps --chown=nonroot:nonroot /app/packages/protocol-config ./packages/protocol-config
COPY --from=deps --chown=nonroot:nonroot /app/packages/snapshot-artifacts/src/observation-constants.ts ./packages/snapshot-artifacts/src/observation-constants.ts
COPY --from=deps --chown=nonroot:nonroot /app/package.json ./package.json
COPY --from=deps --chown=nonroot:nonroot /app/pnpm-workspace.yaml ./pnpm-workspace.yaml

# Set environment variables
ENV NODE_ENV=production

# Expose the Envio indexer metrics/API port.
EXPOSE 9898

# Start the application
WORKDIR /app/apps/indexer
USER nonroot
CMD ["scripts/start-envio.mjs"]
