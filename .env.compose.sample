# Optional local Docker Compose overrides.
# Copy to .env if you want Docker Compose to load these automatically.

# Host ports
POSTGRES_HOST_PORT=5432
HASURA_HOST_PORT=8080
INDEXER_HOST_PORT=9898
SNAPSHOT_GATEWAY_HOST_PORT=8082
FRONTEND_HOST_PORT=3000
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Local database
POSTGRES_DB=protocol_visualizer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Local Hasura admin secret
HASURA_GRAPHQL_ADMIN_SECRET=local-hasura-admin-secret

# Local S3-compatible bucket served by MinIO
BUCKET=protocol-visualizer-snapshots
ACCESS_KEY_ID=minioadmin
SECRET_ACCESS_KEY=minioadmin
REGION=us-east-1

# Frontend build-time snapshot gateway URL
VITE_PROTOCOL_SNAPSHOT_BASE_URL=http://localhost:8082
SNAPSHOT_PUBLIC_ORIGIN=http://localhost:8082

# Optional local snapshot deployment identity and monitor webhook
INDEXER_DEPLOYMENT_ID=local-compose
DISCORD_WEBHOOK_URL=
MONITOR_STATE_KEY=v1/monitor-state.json
MONITOR_STALE_CHAIN_HOURS=24

# Optional indexer tuning
ENVIO_RPC_MODE=sync
ENVIO_API_TOKEN=
SNAPSHOT_CHAIN_IDS=

# Optional RPC overrides
ENVIO_RPC_URL_1=https://eth.llamarpc.com
ENVIO_RPC_URL_10=https://optimism.llamarpc.com
ENVIO_RPC_URL_42161=https://arb1.arbitrum.io/rpc
ENVIO_RPC_URL_8453=https://base.llamarpc.com
ENVIO_RPC_URL_80094=https://rpc.berachain.com
ENVIO_RPC_URL_11155111=https://ethereum-sepolia-rpc.publicnode.com
