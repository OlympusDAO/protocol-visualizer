# Build stage
# Pinned image: golang:1.25-alpine
FROM golang:1.25-alpine@sha256:8d22e29d960bc50cd025d93d5b7c7d220b1ee9aa7a239b3c8f55a57e987e8d45 AS builder

RUN apk add --no-cache ca-certificates

WORKDIR /src

COPY apps/snapshot-gateway/go.mod apps/snapshot-gateway/go.sum* ./
COPY packages/protocol-config/protocol-chains.json ./config/protocol-chains.json
RUN go mod download

COPY apps/snapshot-gateway/ ./
RUN go test ./... && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /snapshot-gateway .

# Runtime stage
# Pinned image: alpine:3.22
FROM alpine:3.22@sha256:310c62b5e7ca5b08167e4384c68db0fd2905dd9c7493756d356e893909057601

RUN apk upgrade --no-cache ca-certificates

RUN addgroup -S app && adduser -S app -G app

WORKDIR /app
COPY --from=builder /src/config/protocol-chains.json ./config/protocol-chains.json
COPY --from=builder /snapshot-gateway /usr/local/bin/snapshot-gateway

ENV PORT=8080
ENV PROTOCOL_CHAINS_CONFIG_PATH=/app/config/protocol-chains.json
EXPOSE 8080

USER app
CMD ["/usr/local/bin/snapshot-gateway"]
