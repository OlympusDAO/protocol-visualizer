# Dependency stage
# Pinned image: node:24-alpine (Node v24.14.1)
FROM node:24-alpine@sha256:01743339035a5c3c11a373cd7c83aeab6ed1457b55da6a69e014a95ac4e4700b AS deps

# Apply Alpine security updates
RUN apk upgrade --no-cache musl musl-utils zlib libssl3 libcrypto3

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# Set working directory
WORKDIR /app

# Copy pnpm files and root package.json (for overrides)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/indexer/package.json ./apps/indexer/

# Install production dependencies
RUN pnpm install --frozen-lockfile --prod

# Copy source code
COPY apps/indexer/ ./apps/indexer/

# Runtime stage
FROM node:24-alpine@sha256:01743339035a5c3c11a373cd7c83aeab6ed1457b55da6a69e014a95ac4e4700b AS runtime

# Apply Alpine security updates
RUN apk upgrade --no-cache musl musl-utils zlib libssl3 libcrypto3

# Set working directory
WORKDIR /app

# Copy runtime dependencies and source from dependency stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/indexer ./apps/indexer

# Remove package managers from runtime image to reduce toolchain CVE surface.
RUN rm -rf \
    /root/.cache/node/corepack \
    /usr/local/lib/node_modules/corepack \
    /usr/local/lib/node_modules/npm \
    /usr/local/bin/corepack \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/pnpm \
    /usr/local/bin/pnpx

# Set environment variables
ENV NODE_ENV=production

# Use non-root user
RUN addgroup -S app && adduser -S app -G app && chown -R app:app /app

# Expose the port the app runs on
EXPOSE 3000

# Start the application
WORKDIR /app/apps/indexer
USER app
# Known issue: shell-form CMD is required here to expand ${RAILWAY_DEPLOYMENT_ID}
# into the schema argument. This keeps `sh` as PID 1, so signal propagation is
# less robust than a pure exec-form entrypoint.
CMD ["sh", "-c", "./node_modules/.bin/ponder start --schema ${RAILWAY_DEPLOYMENT_ID}"]
