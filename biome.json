{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "assist": {
    "actions": {
      "source": {
        "useSortedPackageJson": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/build",
      "!**/.envio",
      "!**/.turbo",
      "!**/.pnpm-store",
      "!**/coverage",
      "!**/*.tsbuildinfo",
      "!apps/indexer/envio-env.d.ts",
      "!apps/snapshot-gateway/openapi.json"
    ],
    "maxSize": 8388608
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  "linter": {
    "enabled": true,
    "includes": [
      "**/*.{js,mjs,cjs,jsx,ts,tsx,yml,yaml}",
      "!**/*.config.ts",
      "!**/eslint.config.mjs"
    ],
    "rules": {
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      },
      "preset": "recommended",
      "suspicious": {
        "useErrorMessage": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.mjs", "**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noFocusedTests": "error"
          }
        }
      }
    },
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "on"
          }
        }
      },
      "includes": [
        "**/*.{json,jsonc}",
        "!**/package.json",
        "!docs/performance/**",
        "!apps/snapshot-gateway/openapi.json",
        "!apps/indexer/src/generated/**",
        "!apps/indexer/abis/**",
        "!packages/contract-abis/abis/**"
      ]
    },
    {
      "includes": ["scripts/railway-release.cjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
