{
  "name": "protocol-visualizer",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "check:runtime-versions": "node scripts/verify-runtime-versions.mjs",
    "docker:build:frontend": "docker build -f Dockerfile-frontend --build-arg VITE_PONDER_URL=https://example.com -t protocol-visualizer/frontend:local .",
    "docker:build:indexer": "docker build -f Dockerfile-indexer -t protocol-visualizer/indexer:local .",
    "docker:tag:scan:frontend": "docker tag protocol-visualizer/frontend:local protocol-visualizer/frontend:scan",
    "docker:tag:scan:indexer": "docker tag protocol-visualizer/indexer:local protocol-visualizer/indexer:scan",
    "dev": "turbo run dev",
    "lint:check": "turbo run lint:check",
    "lint": "turbo run lint && prettier --write \"**/*.{js,mjs,ts,tsx,md,json}\"",
    "validate:local": "pnpm run check:runtime-versions && pnpm install --frozen-lockfile && pnpm run lint:check && pnpm run build && pnpm run docker:build:indexer && pnpm run docker:build:frontend",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,md,json}\"",
    "preinstall": "npx only-allow@1.2.2 pnpm"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.7.4",
    "turbo": "^2.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.13",
      "ajv": "6.14.0",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "drizzle-orm": "0.45.2",
      "esbuild": "0.28.0",
      "fast-uri": "^3.1.2",
      "flatted": "3.4.2",
      "hono": "^4.12.18",
      "kysely": "0.28.17",
      "lodash": "4.18.0",
      "minimatch@<3.1.4": "3.1.5",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "picomatch": "4.0.4",
      "ponder>vite": "6.4.2",
      "postcss": "^8.5.10",
      "rollup": "4.59.0",
      "vite@>=5.0.0 <5.4.21": "6.4.2",
      "yaml": "2.8.3"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.33.0",
    "npm": "use-pnpm",
    "yarn": "use-pnpm"
  }
}
